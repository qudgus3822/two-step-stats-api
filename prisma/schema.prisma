// Prisma 스키마: 정규화된 농구 스탯 이벤트 로그를 Postgres(Supabase)에 저장한다.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// [변경: 2026-07-14 17:32, 김병현 수정] 대회 모델 대개편 — 시즌 문자열 대신 "대회(Competition)"를
// 진짜 행으로 승격하고, stat_events 가 그 행을 외래키(FK)로 참조하게 바꿨다. (year, seasonNo, name)
// 조합 유니크는 seasonNo(시즌번호)가 nullable 이라 Postgres NULL-distinct 함정(NULL 은 서로 다른 값
// 취급)에 걸려 중복을 못 막는다. 그래서 유니크 키를 "결정적으로 계산되는 label 문자열"
// 하나로 통일했다(항상 non-null → upsert 멱등 보장). 집계는 이제 FK 로 competitions 를 조인해서
// 라벨을 읽는다(느슨한 문자열 연결이 아니라 진짜 관계).
model Competition {
  id        Int         @id @default(autoincrement())
  year      Int // 연도 (예: 2026)
  seasonNo  Int? // 시즌번호(선택). NULL 이면 "시즌번호 지정안함"
  name      String // 대회명 (필수, 예: 나이배)
  label     String      @unique // 표시 라벨 겸 유니크 키. competitionLabel() 이 만든 값(예: "2026 시즌3 · 나이배")
  createdAt DateTime    @default(now())
  events    StatEvent[] // 이 대회에 속한 이벤트들
  // [신설: 2026-09-02 김병현 작성] 이 대회의 우승자들(선수마다 한 줄).
  wins      ChampionshipWin[]

  @@map("competitions")
}

// 스탯 이벤트: 엑셀 Rawdata 왼쪽 표 한 행 = 한 레코드 (롱 포맷 이벤트 로그)
// 박스스코어/랭킹 등 모든 파생 스탯은 이 테이블을 집계해서 계산한다.
model StatEvent {
  id            Int         @id @default(autoincrement())
  // [변경: 2026-07-14 17:32, 김병현 수정] season String(느슨한 문자열) → competitionId FK(진짜 관계).
  // onDelete: Restrict — 경기 기록이 있는 대회는 삭제할 수 없다(고아 이벤트 방지).
  competitionId Int
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  week          Int // 주차
  game          Int // 주차 내 경기 번호
  quarter       Int // 쿼터
  player        String // 선수 이름
  stat          String // 스텟 코드 (대문자 정규화)
  team          String // 팀명
  createdAt     DateTime    @default(now())

  @@index([competitionId])
  @@index([competitionId, week, game])
  @@index([player])
  @@map("stat_events")
}

// [신설: 2026-09-02 김병현 작성] 우승 기록 — "한 줄 = 선수 한 명의 우승 하나".
//
// 왜 팀 명단(배열) 한 줄이 아니라 선수마다 한 줄인가:
// 이 동호회는 같은 시즌에 상대팀으로도 한 번 뛰고, 용병으로 여러 경기를 뛰고도 우승자로는
// 안 치는 경우가 있다. 그래서 "누가 우승자인가"는 계산이 아니라 사람이 한 명씩 판단해야 한다.
// 화면도 선수마다 [+] / [취소] 를 누르는 모양이라, 저장 단위도 선수 하나여야 딱 맞는다
// (배열이면 그 안을 헤집어 한 명만 빼야 하는데, 줄이면 그냥 지우면 된다).
//
// @@unique([competitionId, player]) 가 "같은 대회에서 같은 선수가 두 번 우승"을 DB 차원에서 막는다.
// 그래서 [+] 는 몇 번을 눌러도 결과가 같다(멱등) — 화면이 두 번 눌려도 횟수가 2로 튀지 않는다.
//
// teamName 은 "그 대회에서 그 선수가 가장 많이 뛴 팀"을 저장 시점에 서버가 계산해 박아 둔다.
// 왜 저장하나(매번 계산하지 않고): 우승 팀 이름은 그때의 사실이다. 나중에 경기 기록을 고치면
// 계산값은 조용히 바뀌지만, 이미 확정된 우승의 팀 이름까지 따라 바뀌면 안 된다.
model ChampionshipWin {
  id            Int         @id @default(autoincrement())
  // onDelete: Restrict — stat_events 와 같은 정책. 우승 기록이 달린 대회는 지울 수 없다.
  // (실무상 우승 기록이 있는 대회엔 경기 기록도 반드시 있어서, 이미 stat_events 쪽에서 먼저 막힌다.)
  competitionId Int
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  player        String // 선수 이름 (stat_events.player 와 같은 표기 — '김진우1' 같은 동명이인 접미사 유지)
  teamName      String // 우승 당시 팀 이름 (위 주석 참고)
  createdAt     DateTime    @default(now())

  @@unique([competitionId, player])
  @@index([player])
  @@map("championship_wins")
}
